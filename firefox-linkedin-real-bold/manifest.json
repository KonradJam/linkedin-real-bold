{
  "manifest_version": 3,
  "name": "LinkedIn Real Bold",
  "version": "0.3.0",
  "description": "Bold selected text in the LinkedIn editor using real formatting, without Unicode substitutes.",
  "browser_specific_settings": {
    "gecko": {
      "id": "linkedin-real-bold@extensions.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*", "https://linkedin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
